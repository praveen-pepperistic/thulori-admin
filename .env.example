# Thulori admin — settings.
# On Vercel: don't use this file. Set API_BASE in Project → Settings → Environment Variables;
#   every build runs config-from-env.sh (vercel.json) and writes js/config.js from it.
# Locally: cp .env.example .env, set API_BASE, then run  sh config-from-env.sh
API_BASE=https://api.example.com   # the Thulori API (server) URL, https://, no trailing slash
